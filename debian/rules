#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	dh_installdirs var/lib/router-pi-controller

override_dh_auto_test:
	#python3 -m pytest -v
	.venv/bin/pytest -v

override_dh_installsystemd:
	install -D -m 0644 \
		packaging/systemd/router_controller.service \
		debian/router-pi-controller/usr/lib/systemd/system/router_controller.service
	dh_installsystemd --name=router_controller